{
  "name": "@eggai/qualops",
  "version": "0.1.0",
  "description": "AI-powered code quality analysis with GitHub Actions integration - automated PR reviews, checks, and annotations",
  "keywords": [
    "code-quality",
    "ai",
    "code-review",
    "automation",
    "github-action",
    "github-actions",
    "pr-review",
    "pull-request",
    "checks-api",
    "claude-ai",
    "anthropic",
    "static-analysis",
    "security",
    "ci-cd"
  ],
  "author": "EggAI Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eggai-tech/qualops.git"
  },
  "homepage": "https://github.com/eggai-tech/qualops#readme",
  "bugs": {
    "url": "https://github.com/eggai-tech/qualops/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "qualops": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config",
    "action.yml"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "build:check": "tsc -p tsconfig.lib.json --noEmit",
    "dev": "tsx --env-file=.env src/cli.ts",
    "test": "LC_ALL=en_US jest",
    "test:integration": "jest --config jest.integration.config.ts",
    "lint": "eslint src tests",
    "lint:fix": "npm run lint -- --fix",
    "qualops": "node --env-file=.env --experimental-strip-types src/cli.ts",
    "qualops:all": "node --env-file=.env --experimental-strip-types src/cli.ts all",
    "qualops:analyze": "node --env-file=.env --experimental-strip-types src/cli.ts analyze",
    "qualops:review": "node --env-file=.env --experimental-strip-types src/cli.ts review",
    "qualops:fix": "node --env-file=.env --experimental-strip-types src/cli.ts fix",
    "qualops:report": "node --env-file=.env --experimental-strip-types src/cli.ts report",
    "qualops:judge": "node --env-file=.env --experimental-strip-types src/cli.ts judge"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@aws-sdk/client-bedrock-runtime": "3.896.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/commander": "2.12.0",
    "commander": "14.0.1",
    "diff": "8.0.2",
    "dotenv": "16.4.5",
    "glob": "13.0.0",
    "openai": "5.23.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/glob": "8.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "minimatch": "^10.0.1",
    "prettier": "3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
