{
  "name": "@eggai/qualops",
  "version": "0.2.1",
  "description": "AI-powered code quality analysis with GitHub Actions integration - automated PR reviews, checks, and annotations",
  "keywords": [
    "code-quality",
    "ai",
    "code-review",
    "automation",
    "github-action",
    "github-actions",
    "pr-review",
    "pull-request",
    "checks-api",
    "claude-ai",
    "anthropic",
    "static-analysis",
    "security",
    "ci-cd"
  ],
  "author": "EggAI Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eggai-tech/qualops.git"
  },
  "homepage": "https://github.com/eggai-tech/qualops#readme",
  "bugs": {
    "url": "https://github.com/eggai-tech/qualops/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "qualops": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config",
    "action.yml",
    "qualops-llm.txt",
    "examples"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "build:check": "tsc -p tsconfig.lib.json --noEmit",
    "dev": "tsx --env-file=.env src/cli.ts",
    "test": "LC_ALL=en_US jest",
    "test:evals": "jest --config evals/jest.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "eslint src tests",
    "lint:fix": "npm run lint -- --fix",
    "qualops": "node --env-file=.env --experimental-strip-types src/cli.ts",
    "qualops:all": "node --env-file=.env --experimental-strip-types src/cli.ts all",
    "qualops:analyze": "node --env-file=.env --experimental-strip-types src/cli.ts analyze",
    "qualops:review": "node --env-file=.env --experimental-strip-types src/cli.ts review",
    "qualops:fix": "node --env-file=.env --experimental-strip-types src/cli.ts fix",
    "qualops:report": "node --env-file=.env --experimental-strip-types src/cli.ts report",
    "qualops:judge": "node --env-file=.env --experimental-strip-types src/cli.ts judge",
    "eval:run:qualops": "node evals/src/run-eval.js --dataset=qualops/qualops",
    "eval:run:crb:all": "node evals/src/run-eval.js --source=crb --mode=agentic",
    "eval:run:crb:sentry": "node evals/src/run-eval.js --dataset=qualops/crb-sentry --mode=agentic",
    "eval:run:crb:grafana": "node evals/src/run-eval.js --dataset=qualops/crb-grafana --mode=agentic",
    "eval:run:crb:calcom": "node evals/src/run-eval.js --dataset=qualops/crb-cal_dot_com --mode=agentic",
    "eval:run:crb:discourse": "node evals/src/run-eval.js --dataset=qualops/crb-discourse --mode=agentic",
    "eval:run:crb:keycloak": "node evals/src/run-eval.js --dataset=qualops/crb-keycloak --mode=agentic",
    "eval:fetch:crb": "node evals/scripts/fetch-crb-dataset.js",
    "eval:upload:all": "node evals/src/upload-datasets.js --source=all",
    "eval:upload:qualops": "node evals/src/upload-datasets.js --source=qualops",
    "eval:upload:crb:all": "node evals/src/upload-datasets.js --source=crb"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.75",
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1008.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/commander": "2.12.5",
    "commander": "^14.0.3",
    "diff": "^8.0.3",
    "dotenv": "^17.3.1",
    "glob": "^13.0.6",
    "openai": "^6.27.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/glob": "9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.3.0",
    "langfuse": "^3.38.6",
    "minimatch": "^10.0.1",
    "prettier": "^3.8.1",
    "promptfoo": "^0.121.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
