{
  "name": "qualops",
  "version": "0.14.0",
  "type": "module",
  "description": "AI-powered code quality pipeline for automated reviews and fixes",
  "keywords": [
    "code-quality",
    "ai",
    "eslint",
    "code-review",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "qualops": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "build:check": "npm run build -- --noEmit",
    "dev": "node --env-file=.env --experimental-strip-types src/cli.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.ts",
    "lint": "eslint src tests",
    "lint:fix": "npm run lint -- --fix",
    "qualops": "node --env-file=.env --experimental-strip-types src/cli.ts",
    "qualops:all": "node --env-file=.env --experimental-strip-types src/cli.ts all",
    "qualops:analyze": "node --env-file=.env --experimental-strip-types src/cli.ts analyze",
    "qualops:review": "node --env-file=.env --experimental-strip-types src/cli.ts review",
    "qualops:fix": "node --env-file=.env --experimental-strip-types src/cli.ts fix",
    "qualops:report": "node --env-file=.env --experimental-strip-types src/cli.ts report",
    "qualops:judge": "node --env-file=.env --experimental-strip-types src/cli.ts judge",
    "qualops:docs:download": "node --env-file=.env --experimental-strip-types src/cli.ts docs:download"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@aws-sdk/client-bedrock-runtime": "3.896.0",
    "@types/commander": "2.12.0",
    "commander": "14.0.1",
    "diff": "8.0.2",
    "dotenv": "16.4.5",
    "openai": "5.23.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "minimatch": "^10.0.1",
    "prettier": "3.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.47.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
